# slskd.yml configuration snippet
# Add this under the 'integration' section of your slskd.yml

integration:
  scripts:
    convert_to_opus:
      on:
        - DownloadDirectoryComplete
      run:
        executable: /usr/bin/python3
        args: /scripts/convert.py
        env:
          DROPPEDNEEDLE_IMPORT_DIR: /import
          OPUS_BITRATE: 160k
          CONVERT_LOSSY: "false"
          DELETE_SOURCE: "false"
